@startuml
actor Automobiliste
boundary Interface
control "Système (Backend)" as Backend
database "Base de données" as DB

ref over Automobiliste, Interface, Backend, DB : Authentification()

Automobiliste -> Interface : 1: Demander la page du catalogue pieces
Interface -> Backend : 1.1: GetCatalogue()
Backend -> DB : 2: Recuperer la liste des pieces
DB --> Backend : 3: Retourner les pieces disponibles
Backend --> Interface : 3.1: Liste des pieces formatée
Interface --> Automobiliste : 4: Afficher le catalogue

Automobiliste -> Interface : 5: Choisir une piece a comparer
Interface -> Backend : 5.1: ComparerOffres(pieceId)
Backend -> DB : 6: Verifier les offres des vendeurs
DB --> Backend : 7: Retourner les offres

alt [valides]
  Backend -> Backend : 8: Calculer le score intelligent
  Backend -> Backend : 9: Classer les offres (prix/proximite)
  Backend --> Interface : 9.1: Resultats de comparaison
  Interface --> Automobiliste : 10: Afficher la comparaison intelligente
else [non valides]
  Backend --> Interface : 10.1: Erreur (Aucune offre)
  Interface --> Automobiliste : 11: Message d'erreur
end

Automobiliste -> Interface : 12: Acceder a la carte des garages
Interface -> Backend : 12.1: FiltrerGarages(criteres)
Backend -> DB : 13: Recuperer les garages filtres
DB --> Backend : 14: Retourner les garages compatibles

alt [trouves]
  Backend --> Interface : 14.1: Donnees cartographiques
  Interface --> Automobiliste : 15: Afficher la carte et les resultats
else [aucun garage trouve]
  Backend --> Interface : 14.2: Liste vide
  Interface --> Automobiliste : 16: Message "Aucun garage trouve"
end

@enduml
